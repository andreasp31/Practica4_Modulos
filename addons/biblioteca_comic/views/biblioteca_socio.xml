<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definimos como mostramos la vista en el modelo -->
    <record id='biblioteca_comic_action_socios' model='ir.actions.act_window'>
        <field name="name">Socios</field>
        <!-- Indicamos a que modelo aplica -->
        <field name="res_model">biblioteca.socio</field>
        <!-- Indicamos que los socios pueden verse en list para el listado,
            y en form para la creación/edición -->
        <field name="view_mode">list,form</field>
    </record>

    <!-- Definición de la Vista formulario -->
    <record id="biblioteca_socio_view_form" model="ir.ui.view">
        <field name="name">Formulario de Comic de la biblioteca</field>
        <field name="model">biblioteca.socio</field>
        <field name="arch" type="xml">
            <form>
                <!-- Creamos un boton "archivar". 
                    Este metodo archivar cambie el estado del atributo del modelo "activo"
                -->
                <header>
                    <button type="object" name="archivar" string="Archivar Socios"/>
                </header>
                <group>
                    <group>
                    <!-- Atributos -->
                        <field name="nombre"/>
                        <field name="apellido"/>
                        <field name="identificacion"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Definir de la vista list -->
    <record id="biblioteca_socio_view_list" model="ir.ui.view">
        <field name="name">Lista de Socios de la Biblioteca</field>
        <field name="model">biblioteca.socio</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="apellido"/>                        
                <field name="identificacion"/>
            </list>
        </field>
    </record>

    <!-- Definir de la vista busqueda-->
    <record id="biblioteca_socio_view_search" model="ir.ui.view">
        <field name="name">Búsqueda de los Socios</field>
        <field name="model">biblioteca.socio</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="apellido"/>
                <field name="identificacion"/>
            </search>
        </field>
    </record>

</odoo>