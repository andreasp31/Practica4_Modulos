<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definimos como mostramos la vista en el modelo -->
    <record id='biblioteca_prestamos_action' model='ir.actions.act_window'>
        <field name="name">Ejemplares</field>
        <!-- Indicamos a que modelo aplica -->
        <field name="res_model">biblioteca.prestamos</field>
        <!-- Indicamos que los socios pueden verse en list para el listado,
            y en form para la creación/edición -->
        <field name="view_mode">list,form</field>
    </record>

    <!-- Definir de la Vista formulario -->
    <record id="biblioteca_prestamo_view_form" model="ir.ui.view">
        <field name="name">Formulario de Prestamo de ejemplares</field>
        <field name="model">biblioteca.prestamos</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                    <!-- Atributos del ejemplar -->
                        <field name="ejemplar_id"/>
                        <field name="codigo"/>
                        <field name="estado"/>
                    </group>
                    <group>
                    <!-- Atributos para el prestamo -->
                        <field name="id_socio"/>
                        <field name="fecha_inicio"/>
                        <field name="fecha_final"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Definir de la vista list -->
    <record id="biblioteca_prestamo_view_list" model="ir.ui.view">
        <field name="name">Lista de Prestamos de la Biblioteca</field>
        <field name="model">biblioteca.prestamos</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="ejemplar_id"/>                        
                <field name="id_socio"/>
                <field name="fecha_inicio"/>                        
                <field name="fecha_final"/>
            </list>
        </field>
    </record>
</odoo>