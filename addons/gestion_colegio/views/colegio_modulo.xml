<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para Modulo -->
    <record id='gestion_colegio.colegio_modulo_action' model='ir.actions.act_window'>
        <field name="name">Módulos</field>
        <field name="res_model">colegio.modulo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Vista de lista de Modulo -->
    <record id="gestion_colegio.colegio_modulo_view_list" model="ir.ui.view">
        <field name="name">Lista de Módulos</field>
        <field name="model">colegio.modulo</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="codigo_modulo"/>
                <field name="horas"/>
                <field name="creditos"/>
                <field name="curso"/>
                <field name="id_ciclo"/>
                <field name="id_profesor"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario de Modulo -->
    <record id="gestion_colegio.colegio_modulo_view_form" model="ir.ui.view">
        <field name="name">Formulario de Módulo</field>
        <field name="model">colegio.modulo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="codigo_modulo"/>
                            <field name="horas"/>
                            <field name="creditos"/>
                        </group>
                        <group>
                            <field name="curso"/>
                            <field name="id_ciclo" widget="many2one"/>
                            <field name="id_profesor" widget="many2one"/>
                        </group>
                    </group>
                    <field name="id_alumno">
                        <list>
                            <field name="nombre"/>
                            <field name="apellidos"/>
                            <field name="dni"/>
                            <field name="fecha_matriculacion"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda de Modulo -->
    <record id="gestion_colegio.colegio_modulo_view_search" model="ir.ui.view">
        <field name="name">Búsqueda de módulos</field>
        <field name="model">colegio.modulo</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="codigo_modulo"/>
                <field name="curso"/>
                <field name="id_ciclo"/>
                <field name="id_profesor"/>
            </search>
        </field>
    </record>
</odoo>