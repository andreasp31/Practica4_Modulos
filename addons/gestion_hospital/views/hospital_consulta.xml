<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definimos como mostramos la vista en el modelo -->
    <record id='gestion_hospital.hospital_consulta_action' model='ir.actions.act_window'>
        <field name="name">Consultas</field>
        <!-- Indicamos a que modelo aplica -->
        <field name="res_model">hospital.consulta</field>
        <!-- Indicamos que los socios pueden verse en list para el listado,
            y en form para la creación/edición -->
        <field name="view_mode">list,form</field>
    </record>

    <!-- Definir de la Vista formulario -->
    <record id="gestion_hospital.hospital_consulta_view_form" model="ir.ui.view">
        <field name="name">Formulario de consulta</field>
        <field name="model">hospital.consulta</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                    <!-- Atributos del medico -->
                        <field name="id_medico"/>
                        <field name="nombre_medico"/>
                        <field name="fecha"/>
                    </group>
                    <group>
                    <!-- Atributos del paciente -->
                        <field name="id_paciente"/>
                        <field name="nombre_paciente"/>
                        <field name="sintoma"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Definir de la vista list -->
    <record id="gestion_hospital.hospital_consulta_view_list" model="ir.ui.view">
        <field name="name">Lista de consultas</field>
        <field name="model">hospital.consulta</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre_medico"/>
                <field name="fecha"/>                        
                <field name="nombre_paciente"/>
                <field name="sintoma"/>                        
            </list>
        </field>
    </record>
</odoo>