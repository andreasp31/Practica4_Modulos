<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definimos como mostramos la vista en el modelo -->
    <record id='gestion_hospital.hospital_paciente_action' model='ir.actions.act_window'>
        <field name="name">Pacientes del hospital</field>
        <!-- Indicamos a que modelo aplica -->
        <field name="res_model">hospital.paciente</field>
        <!-- Indicamos que los pacientes pueden verse en list para el listado,
            y en form para la creación/edición -->
        <field name="view_mode">list,form</field>
    </record>

    <!-- Definir de la Vista formulario -->
    <record id="gestion_hospital.hospital_paciente_view_form" model="ir.ui.view">
        <field name="name">Formulario de los pacientes del hospital</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
            <form>
                <!-- Creamos un boton "archivar". 
                    Al llamarse "archivar" se encarga de llamar al metodo "archivar"
                    del modelo del que hereda "hospital paciente".
                    Este metodo archivar cambie el estado del atributo del modelo "activo"
                -->
                <header>
                    <button type="object" name="archivar" string="Archivar Pacientes"/>
                </header>
                <group>
                    <group>
                        <field name="nombre"/>
                        <field name="apellidos"/>
                    </group>
                </group>
                <group>
                    <field name="sintomas" widget="html"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Definir de la vista list -->
    <record id="gestion_hospital.hospital_paciente_view_list" model="ir.ui.view">
        <field name="name">Lista de los pacientes del hospital</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="apellidos"/>                        
                <field name="sintomas" widget="html"/>
            </list>
        </field>
    </record>

    <!-- Definir de la vista busqueda-->
    <record id="gestion_hospital.hospital_paciente_view_search" model="ir.ui.view">
        <field name="name">Búsqueda de pacientes del hospital</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="apellidos"/>
            </search>
        </field>
    </record>
</odoo>