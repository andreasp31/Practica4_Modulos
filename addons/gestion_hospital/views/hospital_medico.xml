<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Definimos como mostramos la vista en el modelo -->
    <record id='hospital_medico_action' model='ir.actions.act_window'>
        <field name="name">Medico</field>
        <!-- Indicamos a que modelo aplica -->
        <field name="res_model">hospital.medico</field>
        <!-- Indicamos que los medicos pueden verse en list para el listado,
            y en form para la creación/edición -->
        <field name="view_mode">list,form</field>
    </record>

    <!-- Definirde la Vista formulario -->
    <record id="hospital_medico_view_form" model="ir.ui.view">
        <field name="name">Formulario de los médicos del hospital</field>
        <field name="model">hospital.medico</field>
        <field name="arch" type="xml">
            <form>
                <!-- Creamos un boton "archivar". 
                    Este metodo archivar cambie el estado del atributo del modelo "activo"
                -->
                <header>
                    <button type="object" name="archivar" string="Archivar Medicos"/>
                </header>
                <group>
                    <group>
                    <!-- Atributos -->
                        <field name="nombre"/>
                        <field name="apellidos"/>
                        <field name="num_colegiado"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <!-- Definir de la vista list -->
    <record id="hospital_medico_view_list" model="ir.ui.view">
        <field name="name">Lista de médicos del hospital</field>
        <field name="model">hospital.medico</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="apellidos"/>                        
                <field name="num_colegiado"/>
            </list>
        </field>
    </record>

    <!-- Definir de la vista busqueda-->
    <record id="hospital_medico_view_search" model="ir.ui.view">
        <field name="name">Búsqueda de los Médicos</field>
        <field name="model">hospital.medico</field>
        <field name="arch" type="xml">
            <search>
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="num_colegiado"/>
            </search>
        </field>
    </record>
</odoo>